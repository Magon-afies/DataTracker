<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plan_title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/plan_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/plan_size"
                android:inputType="numberDecimal" />

            <Spinner
                android:id="@+id/plan_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:entries="@array/plan_units" />
        </LinearLayout>

        <EditText
            android:id="@+id/plan_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/plan_price_hint"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/plan_carrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/plan_carrier_hint"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/plan_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/plan_start"
            android:inputType="date" />

        <EditText
            android:id="@+id/plan_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/plan_expiry"
            android:inputType="date" />

        <Button
            android:id="@+id/btn_save_plan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/save_plan" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/alerts_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alerts_enable" />

        <LinearLayout
            android:id="@+id/debug_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/debug_usage_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/debug_override_hint"
                android:inputType="number" />

            <Button
                android:id="@+id/btn_clear_debug"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_clear" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alerts_app_cap" />

        <EditText
            android:id="@+id/cap_app_mb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="@null"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alerts_bg_cap" />

        <EditText
            android:id="@+id/cap_bg_mb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="@null"
            android:importantForAutofill="no"
            android:inputType="number" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alerts_save" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="18dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/storage_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/storage_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/storage_loading" />

                <TextView
                    android:id="@+id/storage_cache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/storage_loading" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.7"
                    android:text="@string/storage_cache_note" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_clear_cache"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/storage_clear_cache" />

                    <Button
                        android:id="@+id/btn_storage_settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/storage_open_settings" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btn_notif"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/alerts_allow_notifications"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.7"
            android:text="@string/alerts_note" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
