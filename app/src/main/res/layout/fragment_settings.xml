<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data Plan Settings"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/plan_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Plan size (e.g. 10)"
            android:inputType="numberDecimal" />

        <Spinner
            android:id="@+id/plan_unit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/plan_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Plan price (₦)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/plan_carrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Carrier"
            android:inputType="text" />

        <EditText
            android:id="@+id/plan_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start date (YYYY-MM-DD)" />

        <EditText
            android:id="@+id/plan_expiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expiry date (YYYY-MM-DD)" />

        <Button
            android:id="@+id/btn_save_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save Plan" />
    </LinearLayout>
</ScrollView>
